# Server only. Never prefix these variables with VITE_ or NEXT_PUBLIC_.
GOOGLE_REVIEWS_ACCOUNT_ID=
GOOGLE_REVIEWS_LOCATION_ID=
GOOGLE_REVIEWS_URL=
GOOGLE_REVIEWS_NAMESPACE=site-name
GOOGLE_REVIEWS_CLIENT_ID=
GOOGLE_REVIEWS_CLIENT_SECRET=
GOOGLE_REVIEWS_REFRESH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret with at least 32 characters; scheduler sends it as a Bearer token.
CRON_SECRET=
# Optional public flag; contains NO credentials. Enable after the first successful sync.
VITE_GOOGLE_REVIEWS_ENABLED=false
